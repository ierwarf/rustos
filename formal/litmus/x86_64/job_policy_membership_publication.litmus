X86_64 JobPolicyMembershipPublication
"a process generation must not accept another incarnation's job membership"
{
uint64_t incarnation=1; uint64_t job=11;
uint64_t 1:rax; uint64_t 1:rbx; uint64_t 1:rcx;
}
