X86_64 SchedulerResidentCellPublicationMutant
"Without the full barriers the parked cell is neither seen by the hook nor revoked by the parker's re-read"
{
uint64_t cell=0; uint64_t owner=7;
uint64_t 0:rax; uint64_t 1:rax;
}
