X86_64 JobPolicyIncarnationPublication
"replacement payload must not be accepted under the preceding incarnation"
{
uint64_t incarnation=1; uint64_t payload=0;
uint64_t 1:rax; uint64_t 1:rbx; uint64_t 1:rcx;
}
P0                         | P1                         ;
movq $0,(incarnation)      | movq (incarnation),%rax    ;
movq $1,(payload)          | movq (payload),%rbx        ;
movq $2,(incarnation)      | movq (incarnation),%rcx    ;
exists (1:rax=1 /\ 1:rbx=1 /\ 1:rcx=1)
