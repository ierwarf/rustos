# Rust / Cargo outputs
/target/
**/target/

# RustOS generated images, artifacts, registries, and mdBook output
/build/

# Formal tool working directories. Stable evidence belongs under build/formal;
# solver caches and generated intermediates must never enter source control.
/.tlacache/
/_apalache-out/
**/_apalache-out/
**/__pycache__/
/result_output_dir/
/states/
/formal/fuzz/artifacts/
# Every proof harness under formal/ builds into its own cargo tree; loom and
# shuttle alone reached 360M. They are build caches, not evidence -- the
# evidence each lane seals on lives under build/formal.
/formal/*/target/
/docs/book/
/docs/src/

# Runtime and debug logs
/logs/
*.log
/{qmp_path}

# Debugger and profiling byproducts
/.gdb_history
/perf.data
/perf.data.old
*.profraw
*.profdata
*.gcda
*.gcno
/core
/core.*
hs_err_pid*.log
replay_pid*.log

# Python and local tool caches
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
/.coverage
/htmlcov/
/.cache/
/compile_commands.json
/rust-project.json

# Local environment and editor byproducts. Project-shared .vscode/ is tracked.
/.env
/.env.local
/.direnv/
/.fleet/
/.idea/
*.swp
*.swo
*~
*.tmp
*.bak
*.orig
*.rej
.#*

# Host desktop metadata
.DS_Store
Thumbs.db
Desktop.ini
.nfs*

# Local scratch files
/settings.rs
/kernel/to_codex

# Agent/tool config is tracked: .codex/ (hooks, subagents, project config),
# .agents/ (skills), and .cargo/ (workspace cargo config) live in-repo.
