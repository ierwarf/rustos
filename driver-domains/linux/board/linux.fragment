# SPDX-License-Identifier: GPL-2.0-only
# RustOS Linux DVM baseline: standard PCI assignment plus standard virtio
# transports. Device-class modules deliberately remain modular so production
# profiles can pin only the drivers and firmware that they support.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_MODULE_SIG_HASH="sha256"
CONFIG_MODULE_SIG_KEY_TYPE_RSA=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FW_LOADER=y
CONFIG_FW_CFG_SYSFS=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_UIO=y
# Generic UIO is INTx-only and cannot provide an ivshmem-doorbell MSI-X
# interrupt. The DVM packages its fixed-header-specific MSI-X adapter instead.
# CONFIG_UIO_PCI_GENERIC is not set
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT_UINPUT=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
# Supported production physical-GPU classes. Keep these modular so a display
# DVM loads only the driver matching its assigned PCI function.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=m
CONFIG_BLK_DEV_NVME=m
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_STORAGE=m
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
