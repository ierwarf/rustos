# SPDX-License-Identifier: GPL-2.0-only
# RustOS Linux DVM baseline: standard PCI assignment plus standard virtio
# transports. Device-class modules deliberately remain modular so production
# profiles can pin only the drivers and firmware that they support.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_MODULE_SIG_HASH="sha256"
CONFIG_MODULE_SIG_KEY_TYPE_RSA=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FW_LOADER=y
CONFIG_FW_CFG_SYSFS=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_UIO=y
# Generic UIO is INTx-only and cannot provide an ivshmem-doorbell MSI-X
# interrupt. The DVM packages its fixed-header-specific MSI-X adapter instead.
# CONFIG_UIO_PCI_GENERIC is not set
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_ZONE_DEVICE=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
CONFIG_INPUT_UINPUT=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
# Supported production physical-GPU classes. Keep these modular so a display
# DVM loads only the driver matching its assigned PCI function.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_FBDEV_EMULATION=y
# The display DVM consumes a fixed, kernel-owned DMA-BUF capability. Do not
# expose general guest allocation/import or nested device-assignment surfaces.
# CONFIG_UDMABUF is not set
# CONFIG_DMABUF_MOVE_NOTIFY is not set
# CONFIG_DMABUF_HEAPS is not set
# CONFIG_DRM_AMDGPU_USERPTR is not set
# CONFIG_VFIO is not set
# CONFIG_IOMMUFD is not set
# CONFIG_VIRTIO_IOMMU is not set
# Diagnostic/fallback DRM providers cannot become production display owners.
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_VGEM is not set
# CONFIG_DRM_VKMS is not set
# CONFIG_DRM_SIMPLEDRM is not set
# Firmware supply is sealed into the image; runtime userspace fallback is not.
# CONFIG_FW_LOADER_USER_HELPER is not set
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=m
CONFIG_BLK_DEV_NVME=m
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_STORAGE=m
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
