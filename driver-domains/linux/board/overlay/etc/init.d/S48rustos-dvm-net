#!/bin/sh
# SPDX-License-Identifier: MIT

run_dir=/run/rustos-dvm

start_relay() {
    name=$1
    command=$2
    pid_file="$run_dir/$name.pid"

    if [ -r "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
        return 0
    fi
    rm -f "$pid_file"
    # SysV init executes this script without a stable controlling terminal.
    # Keep the relay detached, but make its bounded lifecycle diagnostics
    # observable on the guest's serial console.  A silently daemonized GUI
    # relay makes a failed capability handshake indistinguishable from a
    # healthy idle relay and invalidates the host readiness gate.
    "$command" serve </dev/null >/dev/console 2>&1 &
    echo "$!" >"$pid_file"
}

stop_relay() {
    name=$1
    pid_file="$run_dir/$name.pid"

    if [ ! -r "$pid_file" ]; then
        return 0
    fi
    pid=$(cat "$pid_file")
    case "$pid" in
        ''|*[!0-9]*) rm -f "$pid_file"; return 0 ;;
    esac
    if kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null || true
        attempts=0
        while kill -0 "$pid" 2>/dev/null && [ "$attempts" -lt 20 ]; do
            sleep 1
            attempts=$((attempts + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -KILL "$pid" 2>/dev/null || true
        fi
    fi
    rm -f "$pid_file"
}

wait_gpu_compositor_ready() {
    pid_file="$run_dir/gpu.pid"
    attempts=0
    while [ "$attempts" -lt 100 ]; do
        [ -r "$run_dir/gpu-compositor-evidence-v1.env" ] && return 0
        if [ ! -r "$pid_file" ] || ! kill -0 "$(cat "$pid_file")" 2>/dev/null; then
            return 1
        fi
        sleep 0.1
        attempts=$((attempts + 1))
    done
    return 1
}

# EGL/context/program setup is part of the GPU pipeline prime, not of a
# best-effort first frame.  A successful steady-state proof is not accepted
# until this separate, atomic marker arrives within the 500 ms contract.
wait_gpu_pipeline_prime() {
    pid_file="$run_dir/gpu.pid"
    attempts=0
    while [ "$attempts" -lt 5 ]; do
        [ -r "$run_dir/gpu-pipeline-prime-v1.env" ] && return 0
        if [ ! -r "$pid_file" ] || ! kill -0 "$(cat "$pid_file")" 2>/dev/null; then
            return 1
        fi
        sleep 0.1
        attempts=$((attempts + 1))
    done
    return 1
}

load_display_drivers() {
    device=
    class=
    alias=

    # Match only assigned display-class PCI functions.  modprobe receives a
    # kernel-produced modalias, never host control-plane text, so it selects
    # exactly the packaged driver for that device instead of probing every GPU
    # driver.  NVIDIA KMS is a separate module and must be enabled explicitly.
    for device in /sys/bus/pci/devices/*; do
        [ -r "$device/class" ] && [ -r "$device/vendor" ] && [ -r "$device/modalias" ] || continue
        class=$(cat "$device/class")
        case "$class" in
            0x03*) ;;
            *) continue ;;
        esac
        alias=$(cat "$device/modalias")
        modprobe "$alias" || continue
        vendor=$(cat "$device/vendor")
        if [ "$vendor" = 0x10de ]; then
            modprobe nvidia_modeset || return 1
            modprobe nvidia_drm modeset=1 fbdev=0 || return 1
        fi
    done
}

start_relays() {
    mkdir -p "$run_dir" && chmod 0700 "$run_dir" || return 1
    # The Ethernet relay is independent. The display relay is admitted only
    # after the fixed-header MSI-X adapter is bound; generic UIO/INTx is not a
    # compatibility path because it cannot receive ivshmem doorbells. Do not
    # start an independent relay before the display prerequisite is admitted;
    # a failed composite start must not leave a partially started appliance.
    if ! load_display_drivers; then
        echo "rustos-dvm: assigned display driver failed to initialize" >&2
        return 1
    fi
    # Remove a prior run's completion before forking: readiness must be fresh
    # evidence from this exact GPU relay PID, never a stale /run artifact.
    rm -f "$run_dir/gpu-pipeline-prime-v1.env" "$run_dir/gpu-pipeline-prime-v1.env.tmp" \
        "$run_dir/gpu-compositor-evidence-v1.env" "$run_dir/gpu-compositor-evidence-v1.env.tmp"
    start_relay gpu /usr/libexec/rustos-dvm-gpu-probe
    if ! wait_gpu_pipeline_prime; then
        echo "rustos-dvm: GPU pipeline prime exceeded its 500 ms admission budget" >&2
        stop_relay gpu
        return 1
    fi
    if ! wait_gpu_compositor_ready; then
        echo "rustos-dvm: fixed-command GPU compositor proof unavailable" >&2
        stop_relay gpu
        return 1
    fi
    if modprobe rustos_dvm_ivshmem_uio; then
        start_relay display /usr/libexec/rustos-dvm-display
    else
        echo "rustos-dvm: display MSI-X UIO module unavailable; refusing display relay" >&2
        return 1
    fi
    if modprobe rustos_dvm_net_uio; then
        start_relay net /usr/libexec/rustos-dvm-net
    else
        echo "rustos-dvm: network WB UIO module unavailable; refusing network relay" >&2
        stop_relay display
        stop_relay gpu
        return 1
    fi
}

stop_relays() {
    # Stop display first so it releases DRM master before networking or reboot.
    stop_relay display
    stop_relay gpu
    stop_relay net
}

case "$1" in
    start) start_relays ;;
    stop) stop_relays ;;
    restart|reload) stop_relays; start_relays ;;
    *) echo "usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
esac
