#!/bin/sh
# SPDX-License-Identifier: MIT

run_dir=/run/rustos-dvm

start_relay() {
    name=$1
    command=$2
    pid_file="$run_dir/$name.pid"

    if [ -r "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
        return 0
    fi
    rm -f "$pid_file"
    # SysV init executes this script without a stable controlling terminal.
    # Keep the relay detached, but make its bounded lifecycle diagnostics
    # observable on the guest's serial console.  A silently daemonized GUI
    # relay makes a failed capability handshake indistinguishable from a
    # healthy idle relay and invalidates the host readiness gate.
    "$command" serve </dev/null >/dev/console 2>&1 &
    echo "$!" >"$pid_file"
}

stop_relay() {
    name=$1
    pid_file="$run_dir/$name.pid"

    if [ ! -r "$pid_file" ]; then
        return 0
    fi
    pid=$(cat "$pid_file")
    case "$pid" in
        ''|*[!0-9]*) rm -f "$pid_file"; return 0 ;;
    esac
    if kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null || true
        attempts=0
        while kill -0 "$pid" 2>/dev/null && [ "$attempts" -lt 20 ]; do
            sleep 1
            attempts=$((attempts + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -KILL "$pid" 2>/dev/null || true
        fi
    fi
    rm -f "$pid_file"
}

start_relays() {
    mkdir -p "$run_dir"
    # The Ethernet relay is independent. The display relay is admitted only
    # after the fixed-header MSI-X adapter is bound; generic UIO/INTx is not a
    # compatibility path because it cannot receive ivshmem doorbells.
    start_relay net /usr/libexec/rustos-dvm-net
    if modprobe rustos_dvm_ivshmem_uio; then
        start_relay display /usr/libexec/rustos-dvm-display
    else
        echo "rustos-dvm: display MSI-X UIO module unavailable; refusing display relay" >&2
    fi
}

stop_relays() {
    # Stop display first so it releases DRM master before networking or reboot.
    stop_relay display
    stop_relay net
}

case "$1" in
    start) start_relays ;;
    stop) stop_relays ;;
    restart|reload) stop_relays; start_relays ;;
    *) echo "usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
esac
