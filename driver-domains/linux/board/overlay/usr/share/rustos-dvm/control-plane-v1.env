# SPDX-License-Identifier: MIT
#
# Source of truth for the Linux DVM pre-transport control endpoint. This is
# staged into the immutable DVM image, hashed into its artifact manifest, and
# read by rustos-dvm-agent. `pretransport` deliberately means that no KVM
# vsock control endpoint or RustOS-to-DVM device data plane is live yet.

CONTROL_SCHEMA=1
CONTROL_PROTOCOL=agent-v1
CONTROL_STATE=pretransport
CONTROL_TRANSPORT=kvm-vsock-pending
CONTROL_AUTHENTICATION=kvm-host-bound-pending
CONTROL_CAPABILITIES=health,device-inventory
