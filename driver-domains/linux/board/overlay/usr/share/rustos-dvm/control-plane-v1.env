# SPDX-License-Identifier: MIT
#
# Source of truth for the Linux DVM host control endpoint. This is staged into
# the immutable DVM image, hashed into its artifact manifest, and read by
# rustos-dvm-agent. `control` exposes only host-authenticated health and
# device inventory; it is not a RustOS-to-DVM device data plane.

CONTROL_SCHEMA=1
CONTROL_PROTOCOL=agent-v1
CONTROL_STATE=control
CONTROL_TRANSPORT=kvm-vsock
CONTROL_AUTHENTICATION=kvm-host-bound
CONTROL_CAPABILITIES=health,device-inventory,keyboard-events
