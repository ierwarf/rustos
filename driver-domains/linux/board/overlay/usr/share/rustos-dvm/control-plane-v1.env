# SPDX-License-Identifier: MIT
#
# Source of truth for the Linux DVM pre-transport control endpoint. This is
# staged into the immutable DVM image, hashed into its artifact manifest, and
# read by rustos-dvm-agent. `pretransport` deliberately means that no Xen
# vchan, grant-table, event-channel, or device data plane is live yet.

CONTROL_SCHEMA=1
CONTROL_PROTOCOL=agent-v1
CONTROL_STATE=pretransport
CONTROL_TRANSPORT=xen-vchan-pending
CONTROL_AUTHENTICATION=l0-domain-bound-pending
CONTROL_CAPABILITIES=health,device-inventory
