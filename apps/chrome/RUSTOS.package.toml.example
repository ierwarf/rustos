id = "chrome"
kind = "app"
execution_domain = "user"
startup = "none"

[build]
builder = "prebuilt-app"
source = "bundle"

[install]
path = "apps/chrome"
layout = "directory"

[[desktop.entries]]
display_name = "Google Chrome"
image = "apps/chrome/chrome"
exec = "/apps/chrome/chrome"
weight_micros = 1000
console_hosted = false
launch = "new-session"
# Job request: what Chrome says it needs, not a machine capacity. loaderd grants
# it exactly against the capacity it observes at launch, or refuses the launch
# naming the limit (see "Application Job request and grant" in
# docs/architecture/job-model.md). A browser is a process tree: browser, GPU or
# software compositor, network and storage utilities and one renderer per site,
# so 24 processes. The browser process alone runs tens of threads (IO, UI,
# thread-pool workers, compositor) and each renderer 10-20. 144 threads is what
# a 256-slot task table leaves of its 192-thread application budget beside the
# UI server's default share (192 - 48): the most Chrome can be granted while
# the session UI is up. On a wider table the same request is a smaller fraction
# and leaves room for other applications. Pages per process are left to the
# loader's derived default (half of physical memory). UNMEASURED: both numbers
# are reasoned headroom, not an observed need; take the real peak from a KVM run
# and set them from that.
request_processes = 24
request_threads = 144
# Interim: RustOS has no user namespaces or setuid sandbox yet, and /data may be
# absent, so Chrome runs unsandboxed with its profile on tmpfs.
args = ["/apps/chrome/chrome", "--ozone-platform=wayland", "--no-sandbox", "--disable-gpu", "--disable-background-networking", "--user-data-dir=/tmp/chrome-profile", "about:blank"]
