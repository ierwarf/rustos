{
  "mcpServers": {
    "serena": {
      "command": "serena",
      "args": ["start-mcp-server"]
    },
    "ast_grep": {
      "command": "ast-grep-server",
      "args": []
    },
    "codegraph": {
      "command": "codegraph-mcp",
      "args": [
        "--mcp",
        "--exclude",
        "target",
        "--exclude",
        "build",
        "--exclude",
        "logs",
        "--exclude",
        "vendor",
        "--exclude",
        "Cargo.lock",
        "--profile",
        "all",
        "--graph-only"
      ]
    }
  }
}
