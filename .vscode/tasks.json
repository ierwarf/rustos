{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build OS",
      "type": "process",
      "command": "cargo",
      "args": [
        "xtask",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "RUSTOS_NATIVE_XHCI": "1",
          "RUSTOS_NATIVE_XHCI_HID_POLL": "1"
        }
      },
      "problemMatcher": []
    }
  ]
}
