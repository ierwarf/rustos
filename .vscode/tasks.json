{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build OS",
      "type": "process",
      "command": "cargo",
      "args": [
        "xtask",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Linux DVM",
      "type": "process",
      "command": "cargo",
      "args": [
        "xtask",
        "build-dvm"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Prepare KVM DVM",
      "dependsOn": [
        "Build OS",
        "Build Linux DVM"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
