{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build OS",
      "type": "process",
      "command": "cargo",
      "args": [
        "xtask",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build OS (no opt)",
      "type": "process",
      "command": "cargo",
      "args": [
        "xtask",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CARGO_PROFILE_RELEASE_OPT_LEVEL": "0"
        }
      },
      "problemMatcher": []
    }
  ]
}
