{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QEMU",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "Build OS (QEMU)",
      "command": "cargo xtask run --profile nvme --usb-input --debugcon null",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "KVM",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "Build OS",
      "command": "cargo xtask run --profile nvme --accel-profile kvm --usb-input --debugcon null",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "KVM (no optimized)",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "Build OS (KVM no optimized)",
      "command": "cargo xtask run --profile nvme --accel-profile kvm --usb-input --debugcon null",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "G14",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "Build OS",
      "command": "cargo xtask run --profile g14 --usb-input --debugcon null",
      "cwd": "${workspaceFolder}"
    }
  ]
}
