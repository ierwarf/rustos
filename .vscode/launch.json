{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QEMU",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "Build OS",
      "command": "exec cargo xtask run",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "KVM",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "Build OS",
      "command": "exec cargo xtask run --accel-profile kvm",
      "cwd": "${workspaceFolder}"
    }
  ]
}
