# Copy this into the immutable L0 host configuration and replace every PCI BDF
# and IOMMU group using `rustos-hostd preflight`. Do not use a group containing
# the L0 boot disk, active display, or other host-critical device.
LAUNCH_PLAN_SCHEMA=1
DOMAIN_ID=linux-dvm-net0
DVM_GUEST_CID=4
IOMMU_GROUP=0
ASSIGNED_PCI_BDFS=0000:00:00.0
HOST_PROTECTED_PCI_BDFS=none
