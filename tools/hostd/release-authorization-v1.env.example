# SPDX-License-Identifier: MIT
# Sign this exact file with the release key. `rustos-hostd acquire --activate`
# verifies the detached signature with a pinned keyring before it changes any
# host driver binding.
RELEASE_AUTHORIZATION_SCHEMA=1
DOMAIN_ID=linux-dvm-net0
DVM_GUEST_CID=4
IOMMU_GROUP=17
ASSIGNED_PCI_BDFS=0000:04:00.0,0000:04:00.1
DVM_ARTIFACT_MANIFEST_SHA256=<64 lowercase hexadecimal characters>
DEVICE_POLICY_SHA256=<64 lowercase hexadecimal characters>
FLEET_POLICY_SHA256=<64 lowercase hexadecimal characters>
# Inclusive Unix-second validity window. Keep release credentials short-lived.
NOT_BEFORE_UNIX=1760000000
NOT_AFTER_UNIX=1760086400
