# SPDX-License-Identifier: MIT
# Hash this exact file and put its SHA-256 into the signed release
# authorization.  Each entry is domain@vsock-cid@iommu-group@bdf+bdf.
# Every domain, CID, IOMMU group, and PCI BDF must be globally unique.
DRIVER_DOMAIN_FLEET_POLICY_SCHEMA=1
FLEET_MEMBERS=linux-dvm-net0@4@17@0000:04:00.0+0000:04:00.1;linux-dvm-net1@5@18@0000:05:00.0
