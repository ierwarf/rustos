# Copy this immutable L0 policy beside the matching launch plan. A release
# manifest must eventually sign both files and bind them to DVM artifact hashes.
# Each device class has one deliberate transport. Do not turn `disabled` into a
# generic proxy: network, block, and display require their own protocol.
DRIVER_DOMAIN_POLICY_SCHEMA=1
DOMAIN_ID=linux-dvm-net0
INPUT_TRANSPORT=input-ring-msix
NETWORK_TRANSPORT=disabled
BLOCK_TRANSPORT=disabled
DISPLAY_TRANSPORT=disabled
